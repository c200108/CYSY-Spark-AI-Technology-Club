{
  "installCommand": "echo skip install, using prebuilt out/",
  "buildCommand": "echo skip build, using prebuilt out/",
  "outputDirectory": "./out",
  "headers": [
    {
      "source": "/*",
      "headers": [
        { "key": "Cross-Origin-Opener-Policy", "value": "same-origin" },
        { "key": "Cross-Origin-Embedder-Policy", "value": "credentialless" }
      ]
    }
  ]
}
