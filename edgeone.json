{
  "installCommand": "npx -y yarn@1.22.22 install --frozen-lockfile --ignore-engines",
  "buildCommand": "npx -y yarn@1.22.22 build",
  "outputDirectory": "./out",
  "nodeVersion": "22.21.1",
  "headers": [
    {
      "source": "/*",
      "headers": [
        { "key": "Cross-Origin-Opener-Policy", "value": "same-origin" },
        { "key": "Cross-Origin-Embedder-Policy", "value": "credentialless" }
      ]
    }
  ]
}
